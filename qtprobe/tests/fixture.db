record(ao, "$(P)number") {
  field(DESC, "QtProbe local test value")
  field(VAL, "12.5") field(PREC, "3") field(EGU, "mA")
  field(LOPR, "-100") field(HOPR, "100") field(DRVL, "-100") field(DRVH, "100")
  field(LOLO, "-80") field(LOW, "-60") field(HIGH, "60") field(HIHI, "80")
  field(LLSV, "MAJOR") field(LSV, "MINOR") field(HSV, "MINOR") field(HHSV, "MAJOR")
  field(PINI, "YES")
}
record(mbbo, "$(P)enum") {
  field(ZRST, "Off") field(ONST, "On") field(TWST, "Standby") field(VAL, "1")
  info(Q:group, {"$(P)group": {"+id": "qtprobe:test/Group:1.0", "mode": {"+channel": "VAL", "+trigger": "*"}}})
}
record(mbbo, "$(P)gain") { field(ZRST, "1") field(ONST, "2") field(TWST, "4") field(THST, "8") field(VAL, "1") field(PINI, "YES") }
record(longout, "$(P)retype") { field(VAL, "12") field(PINI, "YES") }
record(stringout, "$(P)latin") { field(VAL, "plain") }
record(stringout, "$(P)text") { field(VAL, "hello") }
record(longout, "$(P)integer") { field(VAL, "2147483647") }
record(ao, "$(P)wide") { field(VAL, "0") }
record(int64out, "$(P)int64") { field(VAL, "9223372036854775806") }
record(ao, "$(P)protected") { field(VAL, "7") field(ASG, "READONLY") }
record(ao, "$(P)hidden") { field(VAL, "5") field(ASG, "NOACCESS") }
record(waveform, "$(P)array") {
  field(FTVL, "DOUBLE") field(NELM, "8")
  info(Q:group, {"$(P)group": {"list": {"+channel": "VAL", "+type": "plain", "+trigger": "*"}}})
}
record(waveform, "$(P)bytes") { field(FTVL, "CHAR") field(NELM, "16") }
record(waveform, "$(P)longText") { field(FTVL, "CHAR") field(NELM, "64") }
record(calc, "$(P)counter") { field(CALC, "A+1") field(INPA, "$(P)counter NPP") }
record(calc, "$(P)calcLinked") { field(SCAN, "1 second") field(INPA, "$(P)number CP") field(CALC, "A*2") field(FLNK, "$(P)text") }
record(ai, "$(P)disabled") { field(SCAN, "1 second") field(DISA, "1") field(DISV, "1") }
record(calcout, "$(P)slow") { field(CALC, "A") field(ODLY, "2") }
